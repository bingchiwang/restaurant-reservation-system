# Flask Environment
SECRET_KEY=dev-restaurant-secret-key-2026
FLASK_ENV=development

# Database Settings
# Options: 'sqlite' or 'mysql'
DB_TYPE=sqlite

# MySQL (when DB_TYPE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=restaurant_db

# Business Rules
MEAL_DURATION_MINUTES=90
CLEANING_BUFFER_MINUTES=15
MAX_RESERVATION_DAYS=30
MIN_ADVANCE_MINUTES=30
MAX_PARTY_SIZE=10
OPENING_TIME=11:00
CLOSING_TIME=21:30
